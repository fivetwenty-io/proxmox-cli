#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Inject pmx's Homebrew install steps into the cask GoReleaser generates.

GoReleaser writes dist/homebrew/Casks/pmx.rb during a release, and that cask
needs three things Homebrew artifact stanzas cannot give it: the pve/pbs/pdm
persona aliases in bin, a silent bulk link of the ~3,000 staged man pages, and
a link for each persona's shell completions. GoReleaser's own `hooks:` express
all of that, but it emits them as `postflight`/`uninstall_postflight`, the
arbitrary-Ruby blocks Homebrew 6 deprecated in favour of the declarative
`postflight_steps`/`uninstall_postflight_steps`. Its cask template has no way
to emit the replacements (goreleaser#6870), so the release workflow runs this
script over the generated file and pushes the result to the tap itself.

Usage:

    scripts/cask-steps dist/homebrew/Casks/pmx.rb   # edit in place
    scripts/cask-steps --self-test                  # check the injection logic
"""

import argparse
import pathlib
import shutil
import subprocess
import sys
import tempfile

GENERATED_MARKER = "# This file was generated by GoReleaser."

# The stanzas GoReleaser emits from `hooks:`. Finding one means the hooks came
# back in .goreleaser.yaml, and two mechanisms are now fighting over the same
# work, so stop rather than paper over it.
DEPRECATED_STANZAS = (
    "preflight do",
    "postflight do",
    "uninstall_preflight do",
    "uninstall_postflight do",
)

# Anchor: the last `binary "..."` line. Install steps sort after every artifact
# stanza and before `uninstall`/`zap`, and `binary` is the only artifact stanza
# this cask carries (see the note in .goreleaser.yaml about `manpages:` and
# `completions:`).
ANCHOR_PREFIX = '  binary "'

STEPS = '''
  postflight_steps do
    # pve, pbs, and pdm are pmx under a different argv[0] — internal/cli.Persona
    # reads it to pick the command tree — so each one has to be a link to the
    # binary rather than a copy of it.
    symlink "pmx", "bin/pve", source_base: :relative, target_base: :homebrew_prefix,
            overwrite: true, remove_on_uninstall: true
    symlink "pmx", "bin/pbs", source_base: :relative, target_base: :homebrew_prefix,
            overwrite: true, remove_on_uninstall: true
    symlink "pmx", "bin/pdm", source_base: :relative, target_base: :homebrew_prefix,
            overwrite: true, remove_on_uninstall: true

    # Create every target directory first. A globbed `symlink` that matches a
    # single file links to the target path itself unless that path is already
    # a directory, and man5 holds exactly one page — without this, a prefix
    # with no share/man/man5 yet would get a *file* named man5.
    mkdir_p "share/man/man1", base: :homebrew_prefix
    mkdir_p "share/man/man5", base: :homebrew_prefix
    mkdir_p "etc/bash_completion.d", base: :homebrew_prefix
    mkdir_p "share/zsh/site-functions", base: :homebrew_prefix
    mkdir_p "share/fish/vendor_completions.d", base: :homebrew_prefix

    # Bulk-link the man pages and every persona's completions out of the staged
    # cask content. A `manpage` artifact per file would print an ohai line on
    # every link and unlink, roughly 3,000 of them per install for pmx, and a
    # globbed symlink does the same work in silence.
    symlink "share/man/man1/*", "share/man/man1", source_base: :staged_path,
            target_base: :homebrew_prefix, source_glob: true, overwrite: true
    symlink "share/man/man5/*", "share/man/man5", source_base: :staged_path,
            target_base: :homebrew_prefix, source_glob: true, overwrite: true
    # Bash completions go to the compat directory, which bash-completion reads
    # whole. Its other directory loads a file only when the file is named for
    # the command, and these keep their .bash suffix.
    symlink "share/bash-completion/completions/*", "etc/bash_completion.d", source_base: :staged_path,
            target_base: :homebrew_prefix, source_glob: true, overwrite: true
    symlink "share/zsh/site-functions/*", "share/zsh/site-functions", source_base: :staged_path,
            target_base: :homebrew_prefix, source_glob: true, overwrite: true
    symlink "share/fish/vendor_completions.d/*", "share/fish/vendor_completions.d", source_base: :staged_path,
            target_base: :homebrew_prefix, source_glob: true, overwrite: true
  end

  uninstall_postflight_steps do
    # A globbed `symlink` records nothing per link for the uninstall phase, so
    # the links it made are swept out by hand here. Matching on the link target
    # leaves every other formula's and cask's links in these shared directories
    # alone.
    remove ["share/man/man1/*", "share/man/man5/*", "etc/bash_completion.d/*",
            "share/zsh/site-functions/*", "share/fish/vendor_completions.d/*"],
           base: :homebrew_prefix, symlink_target_contains: "/Caskroom/pmx/"
  end
'''

# A trimmed copy of what GoReleaser v2.18.0 writes for this project, used by
# --self-test so a broken anchor fails in CI rather than during a release.
SAMPLE_CASK = '''# This file was generated by GoReleaser. DO NOT EDIT.
cask "pmx" do
  version "1.2.3"

  on_macos do
    on_arm do
      sha256 "deadbeef"
      url "https://example.invalid/pmx_#{version}_darwin_arm64.tar.gz"
    end
  end

  name "pmx"
  desc "Proxmox command-line interface (VE / PBS / PDM)"
  homepage "https://github.com/fivetwenty-io/proxmox-cli"

  livecheck do
    skip "Auto-generated on release."
  end

  binary "pmx"

  # No zap stanza required
end
'''


class InjectionError(Exception):
    """The generated cask is not shaped the way this script expects."""


def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def inject(text: str) -> str:
    """Return the cask with the install step stanzas added after `binary`."""
    if GENERATED_MARKER not in text:
        raise InjectionError(
            "no GoReleaser header — this does not look like a generated cask"
        )
    if "postflight_steps" in text:
        raise InjectionError("the cask already carries install steps")
    for stanza in DEPRECATED_STANZAS:
        if stanza in text:
            raise InjectionError(
                f"the cask carries a deprecated `{stanza.split()[0]}` stanza — "
                "remove homebrew_casks.hooks from .goreleaser.yaml"
            )

    lines = text.splitlines()
    anchors = [i for i, line in enumerate(lines) if line.startswith(ANCHOR_PREFIX)]
    if not anchors:
        raise InjectionError(
            f"no line starting with {ANCHOR_PREFIX!r} to anchor the steps to"
        )

    at = anchors[-1] + 1
    return "\n".join(lines[:at] + STEPS.rstrip("\n").split("\n") + lines[at:]) + "\n"


def ruby_syntax_ok(text: str) -> bool | None:
    """Parse the result with ruby when there is a ruby to parse it with."""
    if shutil.which("ruby") is None:
        return None
    with tempfile.NamedTemporaryFile("w", suffix=".rb") as handle:
        handle.write(text)
        handle.flush()
        result = subprocess.run(
            ["ruby", "-c", handle.name],
            capture_output=True,
            text=True,
        )
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        return False
    return True


def self_test() -> None:
    injected = inject(SAMPLE_CASK)

    checks: list[tuple[str, bool]] = []
    checks.append(("postflight_steps present", "postflight_steps do" in injected))
    checks.append(
        (
            "uninstall_postflight_steps present",
            "uninstall_postflight_steps do" in injected,
        )
    )
    checks.append(
        (
            "steps sort after the binary stanza",
            injected.index('binary "pmx"') < injected.index("postflight_steps do"),
        )
    )
    checks.append(
        (
            "steps sort before the zap comment",
            injected.index("uninstall_postflight_steps do")
            < injected.index("# No zap stanza required"),
        )
    )
    checks.append(
        (
            "persona aliases covered",
            all(f'"bin/{p}"' in injected for p in ("pve", "pbs", "pdm")),
        )
    )
    checks.append(
        (
            "uninstall sweep matches this cask only",
            'symlink_target_contains: "/Caskroom/pmx/"' in injected,
        )
    )

    checks.append(("a second run is refused", refuses(injected)))
    checks.append(
        (
            "a cask with hooks is refused",
            refuses(SAMPLE_CASK.replace("  binary \"pmx\"", "  postflight do\n  end")),
        )
    )
    checks.append(
        (
            "a cask with no binary stanza is refused",
            refuses(SAMPLE_CASK.replace('  binary "pmx"\n', "")),
        )
    )

    syntax = ruby_syntax_ok(injected)
    if syntax is None:
        checks.append(("ruby parses the result (skipped, no ruby)", True))
    else:
        checks.append(("ruby parses the result", syntax))

    failed = [name for name, ok in checks if not ok]
    for name, ok in checks:
        print(f"{'ok  ' if ok else 'FAIL'} {name}")
    if failed:
        die(f"{len(failed)} self-test check(s) failed")
    print(f"\n{len(checks)} checks passed")


def refuses(text: str) -> bool:
    """True when inject() rejects this cask, which is what the caller wants."""
    try:
        inject(text)
    except InjectionError:
        return True
    return False


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Inject pmx's Homebrew install steps into a generated cask.",
    )
    parser.add_argument(
        "cask",
        nargs="?",
        help="path to the cask GoReleaser wrote (dist/homebrew/Casks/pmx.rb)",
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="check the injection logic against a sample cask and exit",
    )
    args = parser.parse_args()

    if args.self_test:
        self_test()
        return

    if not args.cask:
        parser.error("a cask path is required unless --self-test is given")

    path = pathlib.Path(args.cask)
    if not path.is_file():
        die(f"{path} does not exist")

    try:
        injected = inject(path.read_text())
    except InjectionError as err:
        die(f"{path}: {err}")

    if ruby_syntax_ok(injected) is False:
        die(f"{path}: the injected cask does not parse as Ruby")

    path.write_text(injected)
    print(f"injected install steps into {path}")


if __name__ == "__main__":
    main()
