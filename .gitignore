# Compiled binaries
bin/
# The built `pmx` binary at the repo root only — anchored so it does not match
# the cmd/pmx/ source directory.
/pmx
*.test

# Distribution
dist/

# Coverage
coverage.out
coverage.html

# Build artifacts
*.o
*.a
*.so

/manpages/
/manpages-gz/
/completions/

# Local lab/stack configuration (holds addresses and context names)
/config/stack.toml
/config/.env.test

# check-coverage-matrix's comparison copy; removed on success, restored over
# the generated file on failure, so it only survives an interrupted run
/docs/.test-coverage-matrix.stamp

# Local Go workspace used to build against a sibling module checkout (an
# unreleased proxmox-apiclient-go, say). Never committed: CI resolves the
# pinned module version from go.mod alone.
/go.work
/go.work.sum

# Scratch directories some local tooling creates. They hold intermediate
# working state, never anything this repo should carry.
/.superpowers/
/.agents/
