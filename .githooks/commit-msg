#!/bin/sh
# commit-msg hook: reject a commit message that carries AI attribution.
#
# The pattern is ATTRIBUTION_RE in the Makefile, the same one the CI
# attribution job matches, and `make attribution-re` prints it, so this hook
# and CI cannot disagree about what counts as attribution. Lines that start
# with "#" are git's own comments and are not part of the message.
#
# Enable the hooks with: make hooks

msg_file=$1

if [ -z "$msg_file" ] || [ ! -r "$msg_file" ]; then
	echo "commit-msg: git did not pass a readable message file" >&2
	exit 2
fi

if ! command -v make >/dev/null 2>&1; then
	echo "commit-msg: make is not installed, so the attribution check cannot run" >&2
	exit 2
fi

if ! pattern=$(make --no-print-directory --silent attribution-re) || [ -z "$pattern" ]; then
	echo "commit-msg: could not read the attribution pattern from the Makefile" >&2
	exit 2
fi

found=$(grep -v '^#' "$msg_file" | grep -i -E "$pattern")

if [ -n "$found" ]; then
	echo "commit-msg: this message carries AI attribution. Remove the line and commit again:" >&2
	echo "$found" >&2
	exit 1
fi
